# Copie para .env (uso local) e configure as MESMAS variáveis na Vercel. NUNCA publique o .env.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (service_role): só no servidor. Jamais no código da página nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública (anon): usada pela loja para receber atualizações em tempo real
SUPABASE_ANON_KEY=
ADMIN_USER=Cnobre
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-10-ou-mais-caracteres
# Opcional: WhatsApp inicial da loja (55 + DDD + número); depois edite no painel
WHATSAPP=
# Opcional (só para testar): cria 2 produtos de demonstração se o banco estiver vazio
SEED_DEMO=false
# Só para desenvolvimento local em http
COOKIE_SECURE=true
